# --- Secrets (never commit real values; set these in the Railway service Variables) ---
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret

# --- Ordinary configuration ---
# Railway injects PORT automatically; 8787 is only a local default.
PORT=8787
# Set to "production" on the live host so session cookies use SameSite=None; Secure.
NODE_ENV=production

# CORS: the exact public origin(s) allowed to call this API (no trailing slash).
# Comma-separated for multiple origins. For the live portfolio API this is the main
# website's origin(s), e.g. https://bizzbuddy.consulting or the Netlify preview domain.
FRONTEND_URL=

# Build-time frontend API base URL (no secrets). Leave empty when the React build is
# served same-origin by this server (Railway single service). Only set it to an absolute
# https URL when the frontend is hosted on a different origin than the API.
VITE_API_BASE_URL=

# --- Persistent storage (point both at the mounted Railway volume) ---
# Mount ONE Railway volume (e.g. at /data) and set:
#   DATA_DIR=/data            -> SQLite database lives at /data/portfolio.db
#   UPLOAD_DIR=/data/uploads  -> uploaded media persists across deploys
# Leaving these unset keeps the local default folders (data/ and private/storage/uploads).
DATA_DIR=
UPLOAD_DIR=

